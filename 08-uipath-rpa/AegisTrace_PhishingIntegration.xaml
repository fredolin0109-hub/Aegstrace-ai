    <!-- Assign Risk Score if provided -->
    <If Condition="[Not String.IsNullOrWhiteSpace(inputScoreStr) AndAlso IsNumeric(inputScoreStr)]" DisplayName="Parse Score" sap:VirtualizedContainerService.HintSize="688,250" sap2010:WorkflowViewState.IdRef="If_2">
