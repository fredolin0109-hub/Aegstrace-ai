# ─────────────────────────────────────────────────────────────────────────────
# AEGISTRACE Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
DEMO_MODE=true
LOG_LEVEL=INFO

# ── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
REDIS_PORT=6379

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-strong-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ── VirusTotal API ───────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# ── AbuseIPDB API ────────────────────────────────────────────────────────────
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here

# ── Shodan API ────────────────────────────────────────────────────────────────
SHODAN_API_KEY=your-shodan-api-key-here

# ── URLScan.io API ───────────────────────────────────────────────────────────
URLSCAN_API_KEY=your-urlscan-api-key-here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── UiPath RPA Orchestrator ──────────────────────────────────────────────────
UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com
UIPATH_TENANT_NAME=your-tenant-name
UIPATH_CLIENT_ID=your-client-id
UIPATH_USER_KEY=your-user-key
UIPATH_PROCESS_NAME=AegisTrace_PhishingResponse
UIPATH_SIMULATION_MODE=true

# ── ML Model Paths (optional override) ───────────────────────────────────────
# MODEL_PATH=/app/models/aegistrace_xgb.json
