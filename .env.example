# AEGISTRACE Configuration Environment

# System & Runtime
ENV=development
DEBUG=true
DEMO_MODE=true

# Database (SQLite default for dev; PostgreSQL compatible)
DATABASE_URL=sqlite:///./database/aegistrace.db

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,chrome-extension://*

# Threat Intelligence Providers (Optional / Fallback to local DSA & heuristic)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# UiPath Orchestrator & RPA Settings
UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com
UIPATH_ORGANIZATION_UNIT=
UIPATH_TENANT_NAME=
UIPATH_CLIENT_ID=
UIPATH_USER_KEY=
UIPATH_PROCESS_NAME=AegisTrace_PhishingResponse
UIPATH_SIMULATION_MODE=true
