# AEGISTRACE Configuration Environment

# System & Runtime
ENV=development
DEBUG=true
DEMO_MODE=true

# Database (SQLite default for dev; PostgreSQL compatible)
DATABASE_URL=sqlite:///./database/aegistrace.db

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,chrome-extension://*

# Threat Intelligence Providers (Optional / Fallback to local DSA & heuristic)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# UiPath Orchestrator & RPA Settings
UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com
UIPATH_ORGANIZATION_UNIT=
UIPATH_TENANT_NAME=
UIPATH_CLIENT_ID=
UIPATH_USER_KEY=
UIPATH_PROCESS_NAME=AegisTrace_PhishingResponse
UIPATH_SIMULATION_MODE=true
UIPATH_TEST_MODE=true

# Automated Email Alert Settings
ALERT_EMAIL=security-admin@example.com
EMAIL_TEST_MODE=true
MEDIUM_RISK_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=aegistrace-alerts@example.com
SMTP_USE_TLS=true

# Risk Thresholds
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=30
